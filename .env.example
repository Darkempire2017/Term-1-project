# Copy to .env.local for local development, and set the same variables in Vercel.
# Never commit real values.

# Supabase (Project Settings -> API). The service-role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signs session cookies and signup tokens. At least 32 random characters:
#   openssl rand -hex 32
AUTH_SECRET=

# Comma-separated index numbers that get the hardware testing console
DEV_INDEXES=DEV001

# MQTT broker. Leave empty to use the public test broker (wss://broker.hivemq.com:8884/mqtt).
# For real use, set a private broker and its login.
HIVEMQ_BROKER_URL=
HIVEMQ_USERNAME=
HIVEMQ_PASSWORD=

# Email (Gmail SMTP is used first, then Resend)
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
