# Server Configuration
PORT=5050
JWT_SECRET=super_secret_jwt_umbrella_token_change_in_production
FRONTEND_URL=http://localhost:5173

# Supabase Credentials (from https://supabase.com/dashboard/project/<your-ref>/settings/api)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-or-anon-key

# HiveMQ MQTT Broker Configuration
# For HiveMQ Public Broker (instant testing, no account needed):
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_CLIENT_ID=smart-umbrella-server-backend
# For HiveMQ Cloud (Private TLS broker):
# MQTT_BROKER_URL=mqtts://your-cluster-id.s1.eu.hivemq.cloud:8883
# MQTT_USERNAME=your_hivemq_username
# MQTT_PASSWORD=your_hivemq_password

# Email Verification (SMTP)
# For local testing, leave empty to automatically print OTP codes and Ethereal preview URLs to the console.
# Or provide your university SMTP / Gmail App Password:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Smart Umbrella Box" <noreply@smartumbrella.edu>
